@page "/match/{MatchId:guid}"
@using TennisScoreWebApp.Infrastructure.ExternalServices.TennisScoreApi
@using TennisScoreWebApp.Services
@inject NavigationManager Navigation
@inject ITennisApiClient TennisApiClient
@inject HubService HubService
@inject IMatchUndoService MatchUndoService

@implements IAsyncDisposable

@rendermode InteractiveServer

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="mb-0">Match details</h2>
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
        Back to tournament
    </button>
</div>

@if (Match == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title mb-3">@Match.Player1.LastName vs @Match.Player2.LastName</h3>
            <p class="card-text mb-2"><strong>Tournament:</strong> @Match.TournamentName</p>
            <p class="card-text mb-3"><strong>Date:</strong> @($"{Match.StartTime:dd MMM yyyy}")</p>

            <div class="match-correction-actions d-flex align-items-start gap-2 flex-wrap mb-3">
                <NavLink class="btn btn-outline-primary btn-sm" href="@($"/match/{Match.Id}/stats")">
                    Statistics
                </NavLink>
                @if (undoConfirmationRequested)
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap" role="group" aria-label="Confirm undo last point">
                        <span class="fw-semibold">Undo the most recently recorded point?</span>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                disabled="@IsScoreActionInProgress"
                                @onclick="ConfirmUndoLastPoint">
                            Confirm undo
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                disabled="@IsScoreActionInProgress"
                                @onclick="CancelUndoLastPoint">
                            Cancel
                        </button>
                    </div>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            disabled="@IsScoreActionInProgress"
                            aria-label="Undo last recorded point"
                            @onclick="RequestUndoLastPoint">
                        @if (isUndoInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            <span>Undoing...</span>
                        }
                        else
                        {
                            <span>Undo last point</span>
                        }
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(undoFeedbackMessage))
            {
                <div class="alert @UndoFeedbackAlertClass py-2" role="@UndoFeedbackRole" aria-live="polite">
                    @undoFeedbackMessage
                </div>
            }

            @if (IsMatchFinished)
            {
                <div class="alert alert-success d-flex align-items-center justify-content-between gap-3 flex-wrap" role="status">
                    <div>
                        <strong>Match finished</strong>
                        <div>Winner: @WinnerName</div>
                    </div>
                    <div class="fw-semibold">
                        Final score: @MatchScore
                    </div>
                </div>
            }
            
            <h5>Set score</h5>
            @if (Match.Sets != null && Match.Sets.Any())
            {
                <table class="table table-striped table-bordered w-auto text-center align-middle live-score-board @(scoreHighlightActive ? "score-update-highlight" : null)">
                    <thead class="table-light">
                        <tr>
                            <th>Player</th>
                            @if (!IsMatchFinished)
                            {
                                <th>Points</th>
                            }
                            @for (int i = 0; i < Match.Sets.Count; i++)
                            {
                                <th>Set @(i + 1)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start fw-bold">
                                @Match.Player1.LastName
                                @if (@Match.ServingPlayerId == @Match.Player1.Id)
                                {
                                    <span title="Serving" class="ms-1">🎾</span>
                                }
                            </td>
                            @if (!IsMatchFinished)
                            {
                                <td>
                                    <span class="badge bg-warning text-dark fs-6 px-3 score-value">
                                        @(Match.Player1.CurrentScore ?? "0")
                                    </span>
                                </td>
                            }
                            @foreach (var set in Match.Sets)
                            {
                                <td class="score-value">@GetSetCellScore(set, Match.Player1.Id)</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold">
                                @Match.Player2.LastName
                                @if (@Match.ServingPlayerId == @Match.Player2.Id)
                                {
                                    <span title="Serving" class="ms-1">🎾</span>
                                }
                            </td>
                            @if (!IsMatchFinished)
                            {
                                <td>
                                    <span class="badge bg-warning text-dark fs-6 px-3 score-value">
                                        @(Match.Player2.CurrentScore ?? "0")
                                    </span>
                                </td>
                            }
                            @foreach (var set in Match.Sets)
                            {
                                <td class="score-value">@GetSetCellScore(set, Match.Player2.Id)</td>
                            }
                        </tr>
                    </tbody>
                </table>

            }
            else
            {
                <p>Match not started yet.</p>
            }
        </div>
    </div>

    <style>
        .point-actions-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }

        .point-action-button {
            min-height: 2.5rem;
            text-align: left;
        }

        .point-action-section + .point-action-section {
            border-top: 1px solid var(--bs-border-color);
            margin-top: 1rem;
            padding-top: 1rem;
        }

        .point-action-section-title {
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .02em;
            text-transform: uppercase;
        }

        .match-correction-actions .btn {
            min-height: 2.75rem;
        }

        @@media (max-width: 576px) {
            .point-actions-grid {
                grid-template-columns: 1fr;
            }

            .point-action-button {
                text-align: center;
            }

            .match-correction-actions > .btn,
            .match-correction-actions > a.btn {
                flex: 1 0 100%;
            }
        }
    </style>

    @if (IsMatchFinished)
    {
        <div class="alert alert-secondary" role="status">
            Scoring is closed for this completed match.
        </div>
    }
    else
    {
        <h4 class="mb-3">Add a point</h4>
        <div class="row g-3 mb-4">
            @foreach (var player in new[] { Match.Player1, Match.Player2 })
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="mb-0">@GetPlayerName(player)</h5>
                                    <small class="text-muted">Record an event by this player</small>
                                </div>
                                @if (Match.ServingPlayerId == player.Id)
                                {
                                    <span class="badge bg-light text-dark border" title="Serving">Serving</span>
                                }
                            </div>

                            <div class="point-action-section">
                                <div class="point-action-section-title text-success mb-2">
                                    Point won by @GetPlayerName(player)
                                </div>
                                <div class="point-actions-grid">
                                    @foreach (var pointType in PointWonActions)
                                    {
                                        <button type="button"
                                                class="btn @GetPointClass(pointType) point-action-button"
                                                disabled="@IsPointActionDisabled(player, pointType)"
                                                title="@GetPointActionTitle(player, pointType)"
                                                @onclick="(() => AddPoint(player.Id, pointType))">
                                            @GetPointLabel(pointType)
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="point-action-section">
                                <div class="point-action-section-title text-danger mb-2">
                                    Error by @GetPlayerName(player), point to @GetPlayerName(GetOpponent(player))
                                </div>
                                <div class="point-actions-grid">
                                    @foreach (var pointType in OpponentPointActions)
                                    {
                                        <button type="button"
                                                class="btn @GetPointClass(pointType) point-action-button"
                                                disabled="@IsPointActionDisabled(player, pointType)"
                                                title="@GetPointActionTitle(player, pointType)"
                                                @onclick="(() => AddPoint(GetOpponent(player).Id, pointType))">
                                            @GetPointLabel(pointType)
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly PointType[] PointWonActions =
    [
        PointType.Ace,
        PointType.Winner
    ];

    private static readonly PointType[] OpponentPointActions =
    [
        PointType.ForcedError,
        PointType.UnforcedError,
        PointType.DoubleFault,
        PointType.TimeViolation
    ];

    [Parameter] public Guid MatchId { get; set; }
    private MatchDetailsDto? Match { get; set; }
    private bool scoreHighlightActive;
    private int scoreHighlightVersion;
    private bool undoConfirmationRequested;
    private bool isUndoInProgress;
    private bool isPointActionInProgress;
    private string? undoFeedbackMessage;
    private UndoMatchOutcome? undoFeedbackOutcome;

    protected override async Task OnInitializedAsync()
    {
        Match = await TennisApiClient.MatchesGETAsync(MatchId);

        // Hub connection
        await HubService.StartAsync(matchId: MatchId);

        // Subscribe to updates
        HubService.OnMatchUpdated += UpdateMatch;
    }

    private void UpdateMatch(MatchDetailsDto updatedMatch)
    {
        InvokeAsync(() =>
        {
            if (updatedMatch.Id == Match?.Id)
            {
                var scoreChanged = GetScoreSignature(Match) != GetScoreSignature(updatedMatch);
                Match = updatedMatch;

                if (scoreChanged)
                {
                    _ = FlashScoreAsync(++scoreHighlightVersion);
                }

                StateHasChanged();
            }
        });
    }

    private bool IsMatchFinished
        => Match?.IsCompleted == true || Match?.EndTime != null || !string.IsNullOrWhiteSpace(WinnerName);

    private bool IsScoreActionInProgress
        => isUndoInProgress || isPointActionInProgress;

    private string UndoFeedbackAlertClass
        => undoFeedbackOutcome switch
        {
            UndoMatchOutcome.Success => "alert-success",
            UndoMatchOutcome.RefreshFailed => "alert-warning",
            _ => "alert-danger"
        };

    private string UndoFeedbackRole
        => undoFeedbackOutcome == UndoMatchOutcome.Success ? "status" : "alert";

    private string WinnerName
        => $"{Match?.WinnerFirstName} {Match?.WinnerLastName}".Trim();

    private string MatchScore
        => !string.IsNullOrWhiteSpace(Match?.Score)
            ? Match.Score
            : Match?.Sets == null || !Match.Sets.Any()
                ? "0-0"
                : string.Join(" ", Match.Sets.Select(set => set.DisplayScore ?? $"{set.Player1Games}-{set.Player2Games}"));

    private static string GetScoreSignature(MatchDetailsDto match)
    {
        var setScores = match.Sets == null
            ? string.Empty
            : string.Join("|", match.Sets.Select(set =>
                $"{set.Player1Games}-{set.Player2Games}-{set.Player1TieBreakPoints}-{set.Player2TieBreakPoints}-{set.DisplayScore}"));

        return $"{match.Player1.CurrentScore}|{match.Player2.CurrentScore}|{match.Score}|{match.IsCompleted}|{setScores}";
    }

    private async Task FlashScoreAsync(int version)
    {
        scoreHighlightActive = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(850);

        if (version == scoreHighlightVersion)
        {
            scoreHighlightActive = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetSetCellScore(SetScoreDto set, Guid playerId)
    {
        var isPlayer1 = Match?.Player1.Id == playerId;
        var games = isPlayer1 ? set.Player1Games : set.Player2Games;
        var otherGames = isPlayer1 ? set.Player2Games : set.Player1Games;
        var tieBreakPoints = isPlayer1 ? set.Player1TieBreakPoints : set.Player2TieBreakPoints;

        if (set.IsSuperTieBreak && tieBreakPoints.HasValue)
            return tieBreakPoints.Value.ToString();

        if (set.IsTieBreak && games < otherGames && tieBreakPoints.HasValue)
            return $"{games}({tieBreakPoints})";

        return games.ToString();
    }

    private static string GetPlayerName(PlayerDto player)
        => $"{player.FirstName} {player.LastName}".Trim();

    private PlayerDto GetOpponent(PlayerDto player)
        => Match?.Player1.Id == player.Id ? Match.Player2 : Match?.Player1 ?? player;

    private bool IsServing(PlayerDto player)
        => Match?.ServingPlayerId == player.Id;

    private static bool IsServerOnlyPoint(PointType pointType)
        => pointType is PointType.Ace or PointType.DoubleFault;

    private bool IsPointActionDisabled(PlayerDto player, PointType pointType)
        => IsScoreActionInProgress || IsServerOnlyPoint(pointType) && !IsServing(player);

    private string GetPointActionTitle(PlayerDto player, PointType pointType)
        => IsScoreActionInProgress
            ? "Wait for the current score update to finish."
            : IsPointActionDisabled(player, pointType)
            ? $"{GetPointLabel(pointType)} can only be recorded for the serving player."
            : GetPointLabel(pointType);

    private static string GetPointLabel(PointType pointType)
        => pointType switch
        {
            PointType.Ace => "Ace",
            PointType.DoubleFault => "Double fault",
            PointType.Fault => "Fault",
            PointType.Winner => "Winner",
            PointType.UnforcedError => "Unforced error",
            PointType.ForcedError => "Forced error",
            PointType.Let => "Let",
            PointType.TimeViolation => "Time violation",
            _ => pointType.ToString()
        };

    private string GetPointClass(PointType pt)
        => pt switch
        {
            PointType.Ace => "btn-outline-success",
            PointType.Winner => "btn-outline-primary",
            PointType.ForcedError => "btn-outline-info",
            PointType.UnforcedError => "btn-outline-warning",
            PointType.DoubleFault => "btn-outline-danger",
            PointType.Fault => "btn-outline-secondary",
            PointType.Let => "btn-outline-secondary",
            PointType.TimeViolation => "btn-outline-dark",
            _ => "btn-outline-secondary"
        };

    private async Task AddPoint(Guid player, PointType pointType)
    {
        if (Match == null || IsMatchFinished || IsScoreActionInProgress) return;

        var scoreBeforePoint = GetScoreSignature(Match);
        var addPointRequest = new AddPointRequest
        {
            MatchId = Match.Id,
            WinnerId = player,
            PointType = pointType
        };

        isPointActionInProgress = true;
        try
        {
            // Add the point through the API
            await TennisApiClient.AddPointAsync(addPointRequest);

            // Reconcile with the authoritative API response after SignalR propagation.
            var updatedMatch = await TennisApiClient.MatchesGETAsync(Match.Id);
            Match = updatedMatch;

            if (scoreBeforePoint != GetScoreSignature(Match))
            {
                _ = FlashScoreAsync(++scoreHighlightVersion);
            }
        }
        finally
        {
            isPointActionInProgress = false;
        }
    }

    private void RequestUndoLastPoint()
    {
        if (IsScoreActionInProgress) return;

        undoFeedbackMessage = null;
        undoFeedbackOutcome = null;
        undoConfirmationRequested = true;
    }

    private void CancelUndoLastPoint()
    {
        if (IsScoreActionInProgress) return;
        undoConfirmationRequested = false;
    }

    private async Task ConfirmUndoLastPoint()
    {
        if (Match == null || IsScoreActionInProgress) return;

        undoConfirmationRequested = false;
        isUndoInProgress = true;
        undoFeedbackMessage = null;
        undoFeedbackOutcome = null;

        var scoreBeforeUndo = GetScoreSignature(Match);
        try
        {
            var result = await MatchUndoService.UndoLastPointAsync(Match.Id);
            undoFeedbackMessage = result.Message;
            undoFeedbackOutcome = result.Outcome;

            if (result.Match is not null)
            {
                Match = result.Match;
                if (scoreBeforeUndo != GetScoreSignature(Match))
                {
                    _ = FlashScoreAsync(++scoreHighlightVersion);
                }
            }
        }
        finally
        {
            isUndoInProgress = false;
        }
    }

    private void GoBack()
    {
        if (Match?.TournamentId != null)
            Navigation.NavigateTo($"/tournaments/{Match.TournamentId}");
        else
            Navigation.NavigateTo("/tournaments");
    }

    public ValueTask DisposeAsync()
    {
        HubService.OnMatchUpdated -= UpdateMatch;
        return ValueTask.CompletedTask;
    }
}
